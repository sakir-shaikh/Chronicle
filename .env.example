# Chronicle Environment Variables
# Copy this file to .env and fill in the values.

# GEMINI_API_KEY: Required for real AI-powered post generation.
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# VITE_APP_URL: Public URL where this app is deployed.
# Used for generating shareable attendee portal links.
# Only VITE_ prefixed variables are exposed to the client bundle.
VITE_APP_URL="http://localhost:3000"
